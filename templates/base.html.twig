<!DOCTYPE html>
<html lang="fr">
    <head>
        {# balises SEO rendues côté serveur à partir de la prop "seo" (ProjectsController) #}
        {% set seo = page.props.seo ?? {} %}
        {% set seo_title = seo.title ?? 'Sylvain Pillet – Développeur web freelance' %}
        {% set seo_description = seo.description ?? '' %}
        {% set route = app.request.attributes.get('_route') %}
        {% set canonical = route ? url(route, app.request.attributes.get('_route_params')) : null %}
        {% set share_image = absolute_url(asset('images/sylvain-pillet.jpg')) %}

        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{{ seo_title }}</title>
        <meta name="description" content="{{ seo_description }}">
        <meta name="keywords" content="développeur React freelance, développeur frontend Toulouse, développeur web freelance, React, TypeScript, Symfony, performance web, SEO technique, UI/UX, développeur web France">
        <meta name="author" content="Sylvain Pillet">
        <meta name="robots" content="{{ seo.robots ?? 'index, follow' }}">
        {% if canonical %}
        <link rel="canonical" href="{{ canonical }}">
        {% endif %}

        <link rel="icon" href="{{ asset('favicon.ico') }}" sizes="any">
        <meta name="theme-color" content="#36013f">

        <meta name="geo.region" content="FR-31">
        <meta name="geo.placename" content="Toulouse">
        <meta name="geo.position" content="43.6045;1.4442">
        <meta name="ICBM" content="43.6045, 1.4442">

        <meta property="og:type" content="website">
        <meta property="og:site_name" content="Sylvain Pillet">
        <meta property="og:locale" content="fr_FR">
        <meta property="og:title" content="{{ seo_title }}">
        <meta property="og:description" content="{{ seo_description }}">
        {% if canonical %}
        <meta property="og:url" content="{{ canonical }}">
        {% endif %}
        <meta property="og:image" content="{{ share_image }}">
        <meta property="og:image:width" content="421">
        <meta property="og:image:height" content="500">
        <meta property="og:image:alt" content="Sylvain Pillet, développeur web freelance React et frontend à Toulouse">
        {# image portrait : carte "summary" (la grande carte attend du 2:1) #}
        <meta name="twitter:card" content="summary">
        <meta name="twitter:title" content="{{ seo_title }}">
        <meta name="twitter:description" content="{{ seo_description }}">
        <meta name="twitter:image" content="{{ share_image }}">

        <script type="application/ld+json">
            {{ {
                '@context': 'https://schema.org',
                '@type': 'Person',
                'name': 'Sylvain Pillet',
                'url': url('home'),
                'image': share_image,
                'jobTitle': 'Développeur web freelance – React & Frontend',
                'description': 'Développeur web freelance à Toulouse, spécialisé React et frontend : interfaces modernes, performance web et SEO technique.',
                'knowsAbout': ['React', 'TypeScript', 'JavaScript', 'Développement frontend', 'Performance web', 'SEO technique', 'UI/UX', 'Symfony', 'PHP'],
                'address': {'@type': 'PostalAddress', 'addressLocality': 'Toulouse', 'addressRegion': 'Occitanie', 'addressCountry': 'FR'},
                'areaServed': {'@type': 'Country', 'name': 'France'},
                'sameAs': ['https://github.com/sylpi10', 'https://www.linkedin.com/in/sylvain-pillet/'],
            }|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }}
        </script>

        {% block stylesheets %}
             {{ vite_entry_link_tags('styles') }}
        {% endblock %}

        {% block javascripts %}
        {{ inertiaHead(page) }}
        {{ vite_entry_script_tags('app', { dependency: 'react' }) }}
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body>
        {{ inertia(page) }}
    </body>
</html>
